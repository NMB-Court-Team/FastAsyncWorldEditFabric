{
    "schemaVersion": 1,
    "id": "fastasyncworldedit",
    "version": "${version}",
    "name": "FastAsyncWorldEditFabric",
    "description": "Fabric version of Fast Async World Edit.",
    "authors": [],
    "contact": {},
    "license": "GPL-3.0",
    "icon": "assets/fastasyncworldedit/icon.png",
    "environment": "server",
    "entrypoints": {
        "main": [
            {
                "value": "net.astrorbits.fawe.FastAsyncWorldEditMain",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": [
        "fastasyncworldedit.mixins.json"
